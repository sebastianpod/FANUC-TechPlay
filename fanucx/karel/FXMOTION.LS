/PROG  FXMOTION
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "";
PROG_SIZE	= 1262;
CREATE		= DATE 26-11-20  TIME 11:35:16;
MODIFIED	= DATE 26-11-20  TIME 11:35:16;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 69;
MEMORY_SIZE	= 1746;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/MN
   1:   ;
   2:  !VARIABLES INITIALISATION ;
   3:  R[196:FX_MOT_RESULT]=0    ;
   4:  R[197:FX_MOT_ERROR]=0    ;
   5:  R[195:FX_MOT_STATUS]=2    ;
   6:  PR[93:FX_TARGET_EXEC]=PR[90:FX_TARGET_IN]    ;
   7:   ;
   8:  !FRAMES SET UP ;
   9:  UFRAME_NUM=R[198:FX_UFRAME_NUM] ;
  10:  UTOOL_NUM=R[199:FX_UTOOL_NUM] ;
  11:   ;
  12:  !MOTION TYPE SELECTION ;
  13:  IF R[191:FX_MOT_TYPE]=1,JMP LBL[10] ;
  14:  IF R[191:FX_MOT_TYPE]=2,JMP LBL[20] ;
  15:  JMP LBL[90] ;
  16:   ;
  17:  !========= JOINT MOTION ========= ;
  18:  LBL[10] ;
  19:  IF R[194:FX_TERM]=(-1),JMP LBL[11] ;
  20:  IF R[194:FX_TERM]<0,JMP LBL[91] ;
  21:  IF R[194:FX_TERM]>100,JMP LBL[91] ;
  22:  JMP LBL[12] ;
  23:   ;
  24:  LBL[11] ;
  25:J PR[93:FX_TARGET_EXEC] R[193:FX_SPEED]% FINE    ;
  26:  JMP LBL[80] ;
  27:   ;
  28:  LBL[12] ;
  29:J PR[93:FX_TARGET_EXEC] R[193:FX_SPEED]% CNT R[194:FX_TERM]    ;
  30:  JMP LBL[80] ;
  31:   ;
  32:  !======== LINEAR MOTION ======== ;
  33:  LBL[20] ;
  34:  IF R[194:FX_TERM]=(-1),JMP LBL[21] ;
  35:  IF R[194:FX_TERM]<0,JMP LBL[91] ;
  36:  IF R[194:FX_TERM]>100,JMP LBL[91] ;
  37:  JMP LBL[22] ;
  38:   ;
  39:  LBL[21] ;
  40:L PR[93:FX_TARGET_EXEC] R[193:FX_SPEED]mm/sec FINE    ;
  41:  JMP LBL[80] ;
  42:   ;
  43:  LBL[22] ;
  44:L PR[93:FX_TARGET_EXEC] R[193:FX_SPEED]mm/sec CNT R[194:FX_TERM]    ;
  45:  JMP LBL[80] ;
  46:   ;
  47:  LBL[80] ;
  48:  !VALID MOTION ;
  49:  R[196:FX_MOT_RESULT]=1    ;
  50:  R[197:FX_MOT_ERROR]=0    ;
  51:  R[195:FX_MOT_STATUS]=3    ;
  52:  JMP LBL[99] ;
  53:   ;
  54:  LBL[90] ;
  55:  !INVALID MOTION TYPE ;
  56:  R[196:FX_MOT_RESULT]=0    ;
  57:  R[197:FX_MOT_ERROR]=1    ;
  58:  R[195:FX_MOT_STATUS]=6    ;
  59:  JMP LBL[99] ;
  60:   ;
  61:  LBL[91] ;
  62:  !INVALID TERMINATION ;
  63:  R[196:FX_MOT_RESULT]=0    ;
  64:  R[197:FX_MOT_ERROR]=2    ;
  65:  R[195:FX_MOT_STATUS]=6    ;
  66:  JMP LBL[99] ;
  67:   ;
  68:  !EXIT LABEL ;
  69:  LBL[99] ;
/POS
/END

-- Purpose:
-- Routes register-related commands to the appropriate register routine.
--
-- Input:
-- command_code      - Numeric code identifying the register operation.
-- request_arguments - Arguments required by the selected operation.
--
-- Output:
-- operation_status  - Status returned by the selected register routine.
-- response_arguments - Response data produced by the selected operation.
--
-- Supported commands:
-- 100 - Read a numeric register
-- 101 - Write a numeric register
-- 102 - Read numeric register comment
-- 103 - Write numeric register comment
-- 110 - Read a string register
-- 111 - Write a string register
-- 112 - Read string register comment
-- 113 - Write string register comment
-- 120 - Read position register type and axis information
-- 121 - Read a cartesian position register value
-- 122 - Read a joint position register value
-- 123 - Write cartesian position register value
-- 124 - Write joint position register value
-- 125 - Read position register comment
-- 126 - Write position register comment 

ROUTINE fx_handle_register_request(command_code, operation_status : INTEGER; request_arguments, response_arguments : STRING)

BEGIN
	response_arguments = ''
	SELECT (command_code) OF
		CASE (100):
			fx_get_num_reg(request_arguments, response_arguments, operation_status)
		CASE (101):
			fx_set_num_reg(request_arguments, operation_status)
		CASE (102):
			fx_get_num_reg_comment(request_arguments, response_arguments, operation_status)
		CASE (103):
			fx_set_num_reg_comment(request_arguments, operation_status)
		CASE (110):
			fx_get_str_reg(request_arguments, response_arguments, operation_status)
		CASE (111):
			fx_set_str_reg(request_arguments, operation_status)
		CASE (112):
			fx_get_str_reg_comment(request_arguments, response_arguments, operation_status)
		CASE (113):
			fx_set_str_reg_comment(request_arguments, operation_status)
		CASE (120):
			fx_get_pos_reg_type(request_arguments, response_arguments, operation_status)
		CASE (121):
			fx_get_cartesian_pos_reg(request_arguments, response_arguments, operation_status)
		CASE (122):
			fx_get_joint_pos_reg(request_arguments, response_arguments, operation_status)
		CASE (123):
			fx_set_cartesian_pos_reg(request_arguments, operation_status)
		CASE (124):
			fx_set_joint_pos_reg(request_arguments, operation_status)
		CASE (125):
			fx_get_pos_reg_comment(request_arguments, response_arguments, operation_status)
		CASE (126):
			fx_set_pos_reg_comment(request_arguments, operation_status)
	ENDSELECT
	
END fx_handle_register_request
-- Purpose:
-- Reads the current raw integer value of an Analog Input.
--
-- Input:
-- request_arguments - STRING containing the Analog Input index
--                     to be read.
--
-- Output:
-- response_arguments - STRING containing the current raw Analog Input
--                      value in decimal format.
-- operation_status   - Status returned by the input read operation.
--                      A value of 0 indicates a successful read.
--
-- Notes:
-- This routine uses fx_get_integer_port with the io_anin port type.
-- The Analog Input index must be greater than zero.
-- Port availability and the upper index limit are validated by
-- GET_PORT_VAL on the controller.
-- The returned value is a raw controller value and is not scaled
-- to voltage, current or engineering units.

ROUTINE fx_get_analog_input(request_arguments, response_arguments : STRING; operation_status : INTEGER)

BEGIN
	
	fx_get_integer_port(io_anin, operation_status, request_arguments, response_arguments)
	
END fx_get_analog_input


-- Purpose:
-- Reads the comment assigned to an Analog Input.
--
-- Input:
-- request_arguments - STRING containing the Analog Input index.
--
-- Output:
-- response_arguments - STRING containing the Analog Input comment.
-- operation_status   - Status returned by the comment read operation.
--
-- Notes:
-- This routine uses fx_get_port_comment with the io_anin port type.

ROUTINE fx_get_analog_input_comment(request_arguments, response_arguments : STRING; operation_status : INTEGER)

BEGIN

	fx_get_port_comment(io_anin, operation_status, request_arguments, response_arguments)
	
END fx_get_analog_input_comment


-- Purpose:
-- Sets the comment assigned to an Analog Input.
--
-- Input:
-- request_arguments - STRING containing the Analog Input index and comment
--                     separated by the protocol separator '|'.
--
-- Output:
-- operation_status - Status returned by the comment write operation.
--
-- Notes:
-- This routine uses fx_set_port_comment with the io_anin port type.
-- An empty comment clears the existing Analog Input comment.

ROUTINE fx_set_analog_input_comment(request_arguments : STRING; operation_status : INTEGER)

BEGIN

	fx_set_port_comment(io_anin, operation_status, request_arguments)
	
END fx_set_analog_input_comment	


-- Purpose:
-- Reads the current raw integer value of an Analog Output.
--
-- Input:
-- request_arguments - STRING containing the Analog Output index
--                     to be read.
--
-- Output:
-- response_arguments - STRING containing the current raw Analog Output
--                      value in decimal format.
-- operation_status   - Status returned by the output read operation.
--                      A value of 0 indicates a successful read.
--
-- Notes:
-- This routine uses fx_get_integer_port with the io_anout port type.
-- The Analog Output index must be greater than zero.
-- Port availability and the upper index limit are validated by
-- GET_PORT_VAL on the controller.
-- The returned value is a raw controller value and is not scaled
-- to voltage, current or engineering units.

ROUTINE fx_get_analog_output(request_arguments, response_arguments : STRING; operation_status : INTEGER)

BEGIN

	fx_get_integer_port(io_anout, operation_status, request_arguments, response_arguments)
	
END fx_get_analog_output


-- Purpose:
-- Validates and writes a raw integer value to an Analog Output.
--
-- Input:
-- request_arguments - STRING containing the Analog Output index and value
--                     separated by the protocol separator '|'.
--
-- Output:
-- operation_status - Status returned by the validation or Analog Output
--                    write operation. A value of 0 indicates a
--                    successful write.
--                    FX_STATUS_INVALID_ARGUMENT indicates an invalid
--                    request format, index or value.
--
-- Notes:
-- The expected request format is:
-- ANALOG_OUTPUT_INDEX|ANALOG_OUTPUT_VALUE
-- The Analog Output index must be greater than zero.
-- The Analog Output value must contain unsigned decimal digits only.
-- The accepted raw value range is 0 through 65535.
-- Port availability and assignment are validated by SET_PORT_VAL
-- on the controller.
-- The value is not scaled to voltage, current or engineering units.

ROUTINE fx_set_analog_output(request_arguments : STRING; operation_status : INTEGER)

VAR
separator_index, analog_output_index, analog_output_value 	: INTEGER
analog_output_index_text 									: STRING[8]
analog_output_value_text 									: STRING[16]
analog_output_index_is_valid 								: BOOLEAN
analog_output_value_is_valid 								: BOOLEAN

BEGIN
	analog_output_index = 0
	analog_output_value = 0
	analog_output_index_is_valid = FALSE 								
	analog_output_value_is_valid = FALSE
	operation_status = FX_STATUS_INVALID_ARGUMENT
	
	separator_index = INDEX(request_arguments, '|')
	
	IF separator_index > 0 THEN
		analog_output_index_text = SUB_STR(request_arguments, 1, separator_index - 1)
		analog_output_value_text = SUB_STR(request_arguments, separator_index + 1, STR_LEN(request_arguments) - separator_index)
		fx_validate_register_index(analog_output_index_text, analog_output_index_is_valid, analog_output_index)
		
		IF analog_output_index_is_valid THEN
			fx_is_integer_string(analog_output_value_text, analog_output_value_is_valid)
			
			IF analog_output_value_is_valid THEN
				CNV_STR_INT(analog_output_value_text, analog_output_value)
				
				IF analog_output_value <= 65535 THEN
					SET_PORT_VAL(io_anout, analog_output_index, analog_output_value, operation_status)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	
END fx_set_analog_output


-- Purpose:
-- Reads the comment assigned to an Analog Output.
--
-- Input:
-- request_arguments - STRING containing the Analog Output index.
--
-- Output:
-- response_arguments - STRING containing the Analog Output comment.
-- operation_status   - Status returned by the comment read operation.
--
-- Notes:
-- This routine uses fx_get_port_comment with the io_anout port type.

ROUTINE fx_get_analog_output_comment(request_arguments, response_arguments : STRING; operation_status : INTEGER)

BEGIN

	fx_get_port_comment(io_anout, operation_status, request_arguments, response_arguments)
	
END fx_get_analog_output_comment


-- Purpose:
-- Sets the comment assigned to an Analog Output.
--
-- Input:
-- request_arguments - STRING containing the Analog Output index and comment
--                     separated by the protocol separator '|'.
--
-- Output:
-- operation_status - Status returned by the comment write operation.
--
-- Notes:
-- This routine uses fx_set_port_comment with the io_anout port type.
-- An empty comment clears the existing Analog Output comment.

ROUTINE fx_set_analog_output_comment(request_arguments : STRING; operation_status : INTEGER)

BEGIN
	
	fx_set_port_comment(io_anout, operation_status, request_arguments)
	
END fx_set_analog_output_comment
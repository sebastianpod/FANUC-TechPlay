-- Notes:
-- This routine uses fx_get_port_comment with the io_uopout port type.

ROUTINE fx_get_uop_output_comment(request_arguments, response_arguments : STRING; operation_status : INTEGER)

BEGIN
	
	fx_get_port_comment(io_uopout, operation_status, request_arguments, response_arguments)
	
END fx_get_uop_output_comment



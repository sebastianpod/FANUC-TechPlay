-- Purpose:
-- Routes motion configuration commands to the appropriate frame
-- or payload operation routine.
--
-- Input:
-- command_code      - Numeric code identifying the motion
--                     configuration operation.
-- request_arguments - Arguments required by the selected operation.
--
-- Output:
-- operation_status   - Status returned by the selected motion
--                      configuration routine.
-- response_arguments - Response data produced by the selected
--                      operation.
--
-- 600 - Read User Frame
-- 601 - Write User Frame
-- 602 - Read User Frame comment
-- 603 - Write User Frame comment
-- 604 - Read active User Frame number
-- 605 - Write active User Frame number
-- 610 - Read Tool Frame
-- 611 - Write Tool Frame
-- 612 - Read Tool Frame comment
-- 613 - Write Tool Frame comment
-- 614 - Read active Tool Frame number
-- 615 - Set active Tool Frame number
-- 620 - Read Payload
-- 621 - Write Payload
-- 622 - Read Payload comment
-- 623 - Write Payload comment
-- 624 - Read active Payload number
-- 625 - Set active Payload number

ROUTINE fx_handle_motion_config_request(command_code, operation_status : INTEGER; request_arguments, response_arguments : STRING)

BEGIN
	response_arguments = ''
	SELECT (command_code) OF
		CASE (600):
			fx_get_user_frame(request_arguments, response_arguments, operation_status)
		CASE (601):
			fx_set_user_frame(request_arguments, operation_status)
		CASE (602):
			fx_get_user_frame_comment(request_arguments, response_arguments, operation_status)
		CASE (603):
			fx_set_user_frame_comment(request_arguments, operation_status)
		CASE (604):
			fx_get_active_user_frame(request_arguments, response_arguments, operation_status)
		CASE (605):
			fx_set_active_user_frame(request_arguments, operation_status)
		CASE (610):
			fx_get_tool_frame(request_arguments, response_arguments, operation_status)
		CASE (611):
			fx_set_tool_frame(request_arguments, operation_status)
		CASE (612):
			fx_get_tool_frame_comment(request_arguments, response_arguments, operation_status)
		CASE (613):
			fx_set_tool_frame_comment(request_arguments, operation_status)
		CASE (614):
			fx_get_active_tool_frame(request_arguments, response_arguments, operation_status)
		CASE (615):
			fx_set_active_tool_frame(request_arguments, operation_status)
		CASE (620):
			fx_get_payload(request_arguments, response_arguments, operation_status)
		CASE (621):
			fx_set_payload(request_arguments, operation_status)
		CASE (622):
			fx_get_payload_comment(request_arguments, response_arguments, operation_status)
		CASE (623):
			fx_set_payload_comment(request_arguments, operation_status)
		CASE (624):
			fx_get_active_payload(request_arguments, response_arguments, operation_status)
		CASE (625):
			fx_set_active_payload(request_arguments, operation_status)
	ENDSELECT
	
END fx_handle_motion_config_request
	
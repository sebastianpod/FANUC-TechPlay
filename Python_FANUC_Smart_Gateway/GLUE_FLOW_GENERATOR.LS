/PROG  GLUE_FLOW_GENERATOR
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "FlowRandomizer";
PROG_SIZE	= 960;
CREATE		= DATE 26-09-01  TIME 16:25:38;
MODIFIED	= DATE 26-09-21  TIME 20:23:12;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 33;
MEMORY_SIZE	= 1360;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/MN
   1:   ;
   2:  !================================ ;
   3:  !==                            == ;
   4:  !== SIMULATES LIVE GLUE FLOW   == ;
   5:  !== MONITORS FLOW TOLERANCE    == ;
   6:  !==                            == ;
   7:  !================================ ;
   8:   ;
   9:  !UPDATE FLOW EVERY 500 MS ;
  10:  IF (DO[10:GLUE_APPLICATION]=ON) AND ($FAST_CLOCK>R[9:LAST_FLOW_UPDATE]+500) THEN ;
  11:   ;
  12:  !GENERATE SIMULATED FLOW VALUE ;
  13:  R[8:ACTUAL_GLUE_FLOW]=($FAST_CLOCK MOD (R[7:GLUE_FLOW_MAX]-R[6:GLUE_FLOW_MIN]+1)+R[6:GLUE_FLOW_MIN]) ;
  14:   ;
  15:  !STORE LAST UPDATE TIME ;
  16:  R[9:LAST_FLOW_UPDATE]=($FAST_CLOCK) ;
  17:   ;
  18:  ENDIF ;
  19:   ;
  20:  !DETECT FLOW BELOW TOLERANCE ;
  21:  IF (F[6:GLUE_FLOW_ABOVE_TOL]=OFF) AND R[8:ACTUAL_GLUE_FLOW]<105 AND (DO[10:GLUE_APPLICATION]=ON) THEN ;
  22:   ;
  23:  F[5:GLUE_FLOW_BELOW_TOL]=(ON) ;
  24:   ;
  25:  ENDIF ;
  26:   ;
  27:  !DETECT FLOW ABOVE TOLERANCE ;
  28:  IF (F[5:GLUE_FLOW_BELOW_TOL]=OFF) AND R[8:ACTUAL_GLUE_FLOW]>272 AND (DO[10:GLUE_APPLICATION]=ON) THEN ;
  29:   ;
  30:  F[6:GLUE_FLOW_ABOVE_TOL]=(ON) ;
  31:   ;
  32:  ENDIF ;
  33:   ;
/POS
/END

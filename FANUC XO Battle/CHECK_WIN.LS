/PROG  CHECK_WIN
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "WinDetection";
PROG_SIZE	= 2260;
CREATE		= DATE 26-03-10  TIME 10:18:36;
MODIFIED	= DATE 26-07-09  TIME 11:21:48;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 111;
MEMORY_SIZE	= 2704;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/MN
   1:  !Program detects winning line ;
   2:  !Checks rows, columns ;
   3:  !and diagonals for win ;
   4:  !Sets R[11] & DO[2] (win status) ;
   5:  !Sets R[12] (winner symbol) ;
   6:   ;
   7:  !------- Horizontal lines ------- ;
   8:   ;
   9:  !Row 1 Upper (1-2-3) ;
  10:  IF (R[1:CELL_1.1]<>0 AND R[1:CELL_1.1]=R[2:CELL_1.2] AND R[1:CELL_1.1]=R[3:CELL_1.3]) THEN ;
  11:   ;
  12:  !Set win status ;
  13:  R[11:WIN_STATUS]=1    ;
  14:  DO[2:WIN]=ON ;
  15:   ;
  16:  !Store winning symbol ;
  17:  R[12:WINNER_SYMBOL]=R[1:CELL_1.1]    ;
  18:   ;
  19:  ENDIF ;
  20:   ;
  21:  !Early exit if win found ;
  22:  IF R[11:WIN_STATUS]=1,JMP LBL[999] ;
  23:   ;
  24:  !Row 2 Middle (4-5-6) ;
  25:  IF (R[4:CELL_2.1]<>0 AND R[4:CELL_2.1]=R[5:CELL_2.2] AND R[4:CELL_2.1]=R[6:CELL_2.3]) THEN ;
  26:   ;
  27:  R[11:WIN_STATUS]=1    ;
  28:  DO[2:WIN]=ON ;
  29:  R[12:WINNER_SYMBOL]=R[4:CELL_2.1]    ;
  30:   ;
  31:  ENDIF ;
  32:   ;
  33:  !Early exit if win found ;
  34:  IF R[11:WIN_STATUS]=1,JMP LBL[999] ;
  35:   ;
  36:  !Row 3 Bottom (7-8-9) ;
  37:  IF (R[7:CELL_3.1]<>0 AND R[7:CELL_3.1]=R[8:CELL_3.2] AND R[7:CELL_3.1]=R[9:CELL_3.3]) THEN ;
  38:   ;
  39:  R[11:WIN_STATUS]=1    ;
  40:  DO[2:WIN]=ON ;
  41:  R[12:WINNER_SYMBOL]=R[7:CELL_3.1]    ;
  42:   ;
  43:  ENDIF ;
  44:   ;
  45:  !Early exit if win found ;
  46:  IF R[11:WIN_STATUS]=1,JMP LBL[999] ;
  47:   ;
  48:  !-------- Vertical lines -------- ;
  49:   ;
  50:  !Column 1 Left (1-4-7) ;
  51:  IF (R[1:CELL_1.1]<>0 AND R[1:CELL_1.1]=R[4:CELL_2.1] AND R[1:CELL_1.1]=R[7:CELL_3.1]) THEN ;
  52:   ;
  53:  R[11:WIN_STATUS]=1    ;
  54:  DO[2:WIN]=ON ;
  55:  R[12:WINNER_SYMBOL]=R[1:CELL_1.1]    ;
  56:   ;
  57:  ENDIF ;
  58:   ;
  59:  !Early exit if win found ;
  60:  IF R[11:WIN_STATUS]=1,JMP LBL[999] ;
  61:   ;
  62:  !Column 2 Middle (2-5-8) ;
  63:  IF (R[2:CELL_1.2]<>0 AND R[2:CELL_1.2]=R[5:CELL_2.2] AND R[2:CELL_1.2]=R[8:CELL_3.2]) THEN ;
  64:   ;
  65:  R[11:WIN_STATUS]=1    ;
  66:  DO[2:WIN]=ON ;
  67:  R[12:WINNER_SYMBOL]=R[2:CELL_1.2]    ;
  68:   ;
  69:  ENDIF ;
  70:   ;
  71:  !Early exit if win found ;
  72:  IF R[11:WIN_STATUS]=1,JMP LBL[999] ;
  73:   ;
  74:  !Column 3 Right (3-6-9) ;
  75:  IF (R[3:CELL_1.3]<>0 AND R[3:CELL_1.3]=R[6:CELL_2.3] AND R[3:CELL_1.3]=R[9:CELL_3.3]) THEN ;
  76:   ;
  77:  R[11:WIN_STATUS]=1    ;
  78:  DO[2:WIN]=ON ;
  79:  R[12:WINNER_SYMBOL]=R[3:CELL_1.3]    ;
  80:   ;
  81:  ENDIF ;
  82:   ;
  83:  !Early exit if win found ;
  84:  IF R[11:WIN_STATUS]=1,JMP LBL[999] ;
  85:   ;
  86:  !-------- Diagonal lines -------- ;
  87:   ;
  88:  !Diagonal 1 (1-5-9) ;
  89:  IF (R[1:CELL_1.1]<>0 AND R[1:CELL_1.1]=R[5:CELL_2.2] AND R[1:CELL_1.1]=R[9:CELL_3.3]) THEN ;
  90:   ;
  91:  R[11:WIN_STATUS]=1    ;
  92:  DO[2:WIN]=ON ;
  93:  R[12:WINNER_SYMBOL]=R[1:CELL_1.1]    ;
  94:   ;
  95:  ENDIF ;
  96:   ;
  97:  !Early exit if win found ;
  98:  IF R[11:WIN_STATUS]=1,JMP LBL[999] ;
  99:   ;
 100:  !Diagonal 2 (3-5-7) ;
 101:  IF (R[3:CELL_1.3]<>0 AND R[3:CELL_1.3]=R[5:CELL_2.2] AND R[3:CELL_1.3]=R[7:CELL_3.1]) THEN ;
 102:   ;
 103:  R[11:WIN_STATUS]=1    ;
 104:  DO[2:WIN]=ON ;
 105:  R[12:WINNER_SYMBOL]=R[3:CELL_1.3]    ;
 106:   ;
 107:  ENDIF ;
 108:   ;
 109:  !Exit label ;
 110:  LBL[999] ;
 111:   ;
/POS
/END
